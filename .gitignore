# ---- Build output ----
build/
out/
cmake-build-*/

# ---- CMake generated files (if ever configured outside build/) ----
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
compile_commands.json
Makefile
Testing/

# ---- Compiled binaries / intermediates ----
*.o
*.obj
*.exe
*.out
*.app
*.dll
*.dylib
*.so
*.pdb
*.ilk

# Exception: never ignore real mesh assets shipped with the project,
# even though some also end in .obj
!assets/**/*.obj

# ---- Program output (generated each run, not source) ----
output.obj

# ---- VS Code ----
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/cmake-kits.json

# ---- Visual Studio (in case it's opened there too on Windows) ----
.vs/
*.sln
*.vcxproj*
*.suo

# ---- Xcode (in case it's opened there too on Mac) ----
*.xcodeproj/
DerivedData/

# ---- OS clutter ----
.DS_Store
Thumbs.db
